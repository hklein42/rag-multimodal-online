multimodal-rag/db/*
!multimodal-rag/db/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Streamlit
.streamlit/secrets.toml

# OS
.DS_Store
Thumbs.db___mytools/__archive/
